((Drupal,debounce,once)=>{Drupal.behaviors.stickyBanner={attach(context){const [stickyBanner]=once('stickyBanner','.chc-c-sticky-banner',context).filter((banner)=>banner.checkVisibility());if(typeof stickyBanner==='undefined'||stickyBanner.closest('.layout-builder'))return;let initialized=false;const stickyContent=stickyBanner.querySelector('.chc-c-sticky-banner__content');const heading=stickyBanner.querySelector('.chc-c-sticky-banner__heading');const parentWrapper=stickyBanner.parentNode;const expandBtn=heading.querySelector('.chc-c-sticky-banner__expand');const closeBtn=heading.querySelector('.chc-c-sticky-banner__close');const CHC_STICKY_BANNER_TOP='chc-c-sticky-banner--top';const CHC_STICKY_BANNER_CONTENT_OPEN='chc-c-sticky-banner__content--open';const CHC_STICKY_BANNER_BOTTOM='chc-c-sticky-banner--bottom';const CHC_STICKY_BANNER_EXPANDED='chc-c-sticky-banner__content--expanded';expandBtn?.addEventListener('click',()=>{const isExpanded=stickyContent.classList.contains(CHC_STICKY_BANNER_EXPANDED);if(!isExpanded){stickyContent.classList.add(CHC_STICKY_BANNER_EXPANDED,CHC_STICKY_BANNER_CONTENT_OPEN);expandBtn.setAttribute('aria-expanded','true');}else{stickyContent.classList.remove(CHC_STICKY_BANNER_EXPANDED,CHC_STICKY_BANNER_CONTENT_OPEN);expandBtn.setAttribute('aria-expanded','false');}});closeBtn?.addEventListener('click',()=>{stickyBanner.classList.remove(CHC_STICKY_BANNER_BOTTOM);});const isMobile=()=>window.innerWidth<960;const setPlaceholderHeight=()=>{parentWrapper.style.minHeight=`${stickyBanner.offsetHeight}px`;};const handleStickyElement=()=>{const bannerHeight=stickyBanner.offsetHeight;const bannerTop=parentWrapper.getBoundingClientRect().top+window.scrollY;const bannerBottom=bannerTop+bannerHeight;const scrolledPastFully=window.scrollY>bannerBottom;const scrolledToBottom=window.scrollY+window.innerHeight>bannerBottom;if(!scrolledToBottom&&!initialized&&window.scrollY===0)stickyBanner.classList.add(CHC_STICKY_BANNER_BOTTOM);else if(stickyBanner.classLis