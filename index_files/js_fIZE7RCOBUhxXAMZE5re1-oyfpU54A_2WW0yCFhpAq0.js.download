((Drupal,once)=>{Drupal.behaviors.cignaSdcAlert={attach(context){const alerts=once('cignaSdcAlert','.leaf-c-alert',context);alerts.forEach((alert)=>{const startDate=alert.dataset.startDate?new Date(alert.dataset.startDate):null;const endDate=alert.dataset.endDate?new Date(alert.dataset.endDate):null;let currentDate=new Date();if(startDate||endDate)if((currentDate>startDate&&currentDate<endDate)||(currentDate>startDate&&!endDate)||(currentDate<endDate&&!startDate)){alert.classList.add('leaf-c-alert--open');alert.setAttribute('aria-hidden','false');}const button=alert.querySelector('.leaf-c-alert__close');if(button!=null)button.addEventListener('click',()=>{alert.classList.remove('leaf-c-alert--open');alert.hidden=true;});});}};})(Drupal,once);;
Drupal.behaviors.cignaJumpList={attach(context){once('cigna_jump_list_change','.leaf-c-jump-list__select',context).forEach((selectElem)=>{selectElem.addEventListener('change',(e)=>{const selectList=e.target;const errorMessage=selectList?.parentElement?.querySelector('.leaf-c-alert');if(selectList.value!==''){selectList.classList.remove('error');if(errorMessage)errorMessage.classList.remove('leaf-c-alert--open');}});});once('cigna_jump_list','.leaf-c-jump-list__form',context).forEach((jumpListElem)=>{jumpListElem.addEventListener('submit',(e)=>{e.preventDefault();const form=e.target;const selectList=form.querySelector('select');const errorMessage=form.querySelector('.leaf-c-alert');if(selectList)if(selectList.value!==''){selectList.classList.remove('error');if(errorMessage)errorMessage.classList.remove('leaf-c-alert--open');const url=new URL(selectList.value,window.location.origin);if(!['http:','https:'].includes(url.protocol))return;const isExternal=url.origin!==window.location.origin;if(selectList.value.startsWith('#'))location.hash=url.hash;else if(isExternal)window.open(url.href,'_blank','noopener,noreferrer');else window.location.href=url.href;}else{selectList.classList.add('error');if(errorMessage)errorMessage.classList.add('leaf-c-alert--open');}});});}};;
