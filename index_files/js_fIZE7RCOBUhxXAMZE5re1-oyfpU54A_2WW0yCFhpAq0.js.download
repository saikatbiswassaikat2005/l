((Drupal)=>{Drupal.behaviors.promoComponentBehavior={attach(context){function isMobile(breakpoint='lg'){const breakpoints={sm:375,sm_2:560,md:768,lg:960,xl:1200,xxl:1400};return window.innerWidth<breakpoints[breakpoint];}function getLeafRightWavePosition(element){const leafRightWaveSvg=element.querySelector('.decoration-container .leaf-right-wave-svg');const imageTag=element.querySelector('.promo-decoration-image picture, .promo-decoration-image img');if(!isMobile('md')&&leafRightWaveSvg&&imageTag){const image=imageTag.nodeName==='PICTURE'?imageTag.querySelector('img'):imageTag;const setLeafWaveRightPosition=()=>{const windowWidth=window.innerWidth;const imageSlot=image.getBoundingClientRect();const leafWave=leafRightWaveSvg.getBoundingClientRect();let leafWaveRightPosition=0;if(element.classList.contains('leaf-c-promo--image-right')){leafWaveRightPosition=(imageSlot&&windowWidth-imageSlot.left-imageSlot.width)??0;if(leafWaveRightPosition>0){leafRightWaveSvg.classList.add('show');leafRightWaveSvg.style.left=`${Math.floor(imageSlot.width-leafWave.width+2)}px`;}else{leafRightWaveSvg.classList.remove('show');leafRightWaveSvg.style.removeProperty('right');}}};setLeafWaveRightPosition();image.onload=()=>{setLeafWaveRightPosition();};}}const promoElements=context.querySelectorAll('.leaf-c-promo-wrapper--brand-image .leaf-c-promo');if(promoElements)promoElements.forEach((promo)=>{window.addEventListener('resize',()=>{getLeafRightWavePosition(promo);});getLeafRightWavePosition(promo);});}};})(Drupal);;
