,\n    PVS:  "https://v-udds-static.test.digitaledge.cigna.com/cignacom/discoUI.js",\n    PROD: "https://p-udds-static.digitaledge.cigna.com/cignacom/discoUI-03122026.js"\n  };\n\n  var TAG_ID = "discover-tealeaf-loader";\n  if (document.getElementById(TAG_ID)) return;\n\n  function getParam(name) {\n    var m = new RegExp("[?&]" + name + "=([^&]*)").exec(window.location.search);\n    return m ? decodeURIComponent(m[1].replace(/\\+/g, " ")) : "";\n  }\n\n  function getCurrentScriptEl() {\n    if (document.currentScript) return document.currentScript;\n    var s = document.getElementsByTagName("script");\n    return s[s.length - 1];\n  }\n\n  function isAllowedHost() {\n    try {\n      var validHosts = [\'dev.\', \'qa.\', \'rel1.\',\'rel2.\', \'pvs.\', \'d.\', \'q.\', \'r.\', \'w.\', \'www.\'];\n      var host = (window.location.hostname || \'\').toLowerCase();\n      var hasCigna = host.indexOf(\'cigna\') > -1;\n      var ok = false;\n      validHosts.forEach(function (e) {\n        if (host.indexOf(e) > -1) ok = true;\n      });\n      return ok && hasCigna;\n    } catch (e) {\n      return false;\n    }\n  }\n\n  var el = getCurrentScriptEl();\n  var attrEnv = el && el.getAttribute && el.getAttribute("data-discover-env");\n  var qsEnv   = getParam("discoverEnv");\n  var winEnv  = (window.DISCOVER_ENV || "").toString();\n  var env     = (attrEnv || qsEnv || winEnv || "").toUpperCase();\n\n  if (!env) {\n    var host = (location.hostname || "").toLowerCase();\n    if (host.startsWith("localhost") || /^\\d{1,3}(\\.\\d{1,3}){3}$/.test(host)) {\n      env = "DEV";\n    } else if (isAllowedHost()) {\n      if (host.indexOf("pvs.") > -1) {\n        env = "PVS";\n      } else if (\n        host.indexOf("qa.") > -1 || host.indexOf("q.") > -1 ||\n        host.indexOf("rel1.") > -1 || host.indexOf("rel2.") > -1 ||\n        host.indexOf("r.") > -1\n      ) {\n        env = "SIT";\n      } else if (host.indexOf("dev.") > -1 || host.indexOf("d.") > -1) {\n        env = "DEV";\n      } else if (host.indexOf("w.") > -1 || host.indexOf("www.") > -1) {\n        env = "PROD";\n      }\n    }\n  }\n\n  if (!env) return;\n\n  var src = DISCOVER_URLS[env] || DISCOVER_URLS.PROD;\n\n  var s = document.createElement("script");\n  s.id = TAG_ID;\n  s.src = src;\n  s.async = true;\n  s.defer = true;\n  s.setAttribute("data-discover-env", env);\n  s.onerror = function() {\n    try { console.warn("[Discover/Tealeaf] Failed to load for ENV=" + env + " from " + src); } catch (_) {}\n  };\n\n  var head = document.getElementsByTagName("head")[0];\n  if (head) head.appendChild(s);\n  else if (document.body) document.body.appendChild(s);\n  else document.documentElement.appendChild(s);\n\n  try { window.DISCOVER_ENV_RESOLVED = env; } catch (_) {}\n})();',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL4d47468d216b4094bb479330c3449e0e",name:"[1] Reset Data Layer",events:[{modulePath:"gcoe-adobe-client-data-layer/src/lib/events/datalayerPushListener.js",settings:{scope:"all",method:"specificEvent",eventKey:"pageLoad"},ruleOrder:1}],conditions:[],actions:[{modulePath:"gcoe-adobe-client-data-layer/src/lib/actions/resetDatalayer.js",settings:{useComputedState:!0},timeout:2e3,delayNext:!0}]},{id:"RL74c53cf4b43f4f00a18fb85d2a4eb13d",name:"social-facebook-main-tag",events:[{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"onetrust",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals"},leftOperand:"%oneTrustCondition%",rightOperand:"text/javascript"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/de9a3002c47b/d1ca0091bb03/1ebbb7f6907a/RCc02f5493c98e48f889aca3bf5edc4041-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL838754b70643442b9ac7411e3440cf8c",name:"XDM - EDDL Send All",events:[{modulePath:"gcoe-adobe-client-da